{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid))",
        ".validate": "$code.length === 4",
        "guest": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('host').exists()"
        },
        "guestName": {
          ".write": "auth != null && newData.parent().child('guest').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "actions": {
          "$a": {
            ".write": "auth != null && !data.exists() && data.parent().parent().child('guest').val() === auth.uid && newData.child('by').val() === auth.uid"
          }
        },
        "presence": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "left": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        }
      }
    }
  }
}
