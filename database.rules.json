{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid))",
        ".validate": "$code.length === 4",
        "guest": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('host').exists()"
        },
        "guestName": {
          ".write": "auth != null && newData.parent().child('guest').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "actions": {
          "$a": {
            ".write": "auth != null && !data.exists() && data.parent().parent().child('guest').val() === auth.uid && newData.child('by').val() === auth.uid"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "left": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "seasons": {
      "$season": {
        "accounts": {
          "$code": {
            ".read": "auth != null && $code.length === 16",
            ".write": "auth != null && $code.length === 16",
            ".validate": "newData.child('gold').isNumber() && newData.child('gold').val() >= 0"
          }
        }
      }
    },
    "feedback": {
      "$season": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['cat', 'text', 'ts']) && $season.length <= 40",
          "cat": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "season": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "acct": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "ua": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    }
  }
}