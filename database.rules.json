{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid))",
        ".validate": "$code.length === 4",
        "guest": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('host').exists()"
        },
        "guestName": {
          ".write": "auth != null && newData.parent().child('guest').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "actions": {
          "$a": {
            ".write": "auth != null && !data.exists() && data.parent().parent().child('guest').val() === auth.uid && newData.child('by').val() === auth.uid"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "left": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "seasons": {
      "$season": {
        "accounts": {
          "$code": {
            ".read": "auth != null && $code.length === 16",
            ".write": "auth != null && $code.length === 16",
            ".validate": "newData.child('gold').isNumber() && newData.child('gold').val() >= 0"
          }
        }
      }
    },
    "feedback": {
      "$season": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['cat', 'text', 'ts']) && $season.length <= 40",
          "cat": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "season": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "acct": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "ua": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "arena": {
      "q": {
        "$sid": {
          ".read": "auth != null",
          ".validate": "$sid.length <= 24",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (data.exists() && newData.exists() && !data.child('room').exists() && newData.child('by').val() === auth.uid))",
            ".validate": "newData.child('at').isNumber()",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "room": {
              ".validate": "newData.isString() && newData.val().length === 4"
            }
          }
        }
      },
      "r": {
        "$sid": {
          ".read": "auth != null",
          ".validate": "$sid.length <= 24",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.child('pts').isNumber() && newData.child('pts').val() >= 0 && newData.child('pts').val() <= 3000",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            }
          }
        }
      },
      "d": {
        "$sid": {
          ".read": "auth != null",
          ".validate": "$sid.length <= 24",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "$g": {
              ".validate": "newData.child('at').isNumber() && newData.child('res').isString() && newData.child('res').val().length <= 5 && (!newData.child('n').exists() || (newData.child('n').isString() && newData.child('n').val().length <= 10)) && (!newData.child('dk').exists() || (newData.child('dk').isString() && newData.child('dk').val().length <= 20)) && (!newData.child('op').exists() || (newData.child('op').isString() && newData.child('op').val().length <= 10))"
            }
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('at').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 10 && newData.child('w').isString() && newData.child('w').val().length <= 10"
      }
    },
    "tower": {
      "$wk": {
        ".read": "auth != null",
        ".validate": "$wk.length <= 10",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('f').isNumber() && newData.child('f').val() >= 0 && newData.child('f').val() <= 30 && newData.child('at').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 10"
        }
      }
    },
    "ghost": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('at').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 10 && newData.child('dk').isString() && newData.child('dk').val().length <= 20 && newData.child('c').hasChildren())"
      }
    },
    "ghostLog": {
      ".read": "auth != null",
      "$owner": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && auth.uid !== $owner",
          ".validate": "newData.child('at').isNumber() && newData.child('res').isString() && newData.child('res').val().length <= 5 && (!newData.child('n').exists() || (newData.child('n').isString() && newData.child('n').val().length <= 10))"
        }
      }
    }
  }
}
